#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

npx -y --package "$repo_dir" agent-skills \
  --yes \
  --global \
  --agent claude-code \
  --agent codex

models="$HOME/.agents/pstack-models.md"
if [ ! -e "$models" ]; then
  ln -sf "$repo_dir/pstack-models.md" "$models"
  echo "pstack: linked $models to $repo_dir/pstack-models.md."
fi
